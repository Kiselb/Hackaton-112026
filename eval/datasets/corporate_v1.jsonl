{"case_id":"CV1-012","question":"Какие ставки пени указаны в приказах № 101 и № 102 и можно ли по их текстам выбрать приоритетную?","category":"conflict","expected_sources":["example:order_101","example:order_102"],"required_facts":[{"fact_id":"rate_101","description":"Ставка 0,10","patterns":["0[,.]10? *(?:%|процент)"],"source_id":"example:order_101","citation_required":true},{"fact_id":"rate_102","description":"Ставка 0,05","patterns":["0[,.]05 *(?:%|процент)"],"source_id":"example:order_102","citation_required":true},{"fact_id":"uncertain_priority","description":"Приоритет не определён","patterns":["(?:приоритет|основан)[^.]{0,80}(?:не определ|нельзя|нет|отсутств)"],"citation_required":false}],"forbidden_claims":[{"claim_id":"newer_wins","description":"Более поздний приказ автоматически приоритетен","pattern":"(?:более +поздн|№? *102)[^.]{0,70}(?:имеет +приоритет|применяется +вместо|отменяет)"}],"should_abstain":false,"manual_review_required":true,"notes":"Документы имеют разные области применения и не задают правило приоритета."}
{"case_id":"CV1-013","question":"Для сделки направления Альфа: каков срок лицензии и какая ставка пени указана в относящемся к Альфа приказе?","category":"multi_document","expected_sources":["example:product_alpha","example:order_102"],"required_facts":[{"fact_id":"license_term","description":"Лицензия на один год","patterns":["(?:один|1) +год"],"source_id":"example:product_alpha","citation_required":true},{"fact_id":"alpha_rate","description":"Ставка приказа № 102 — 0,05","patterns":["0[,.]05 *(?:%|процент)"],"source_id":"example:order_102","citation_required":true}],"forbidden_claims":[{"claim_id":"wrong_alpha_rate","description":"Приписать направлению Альфа только 0,10","pattern":"Альфа[^.]{0,100}0[,.]10"}],"should_abstain":false,"manual_review_required":true,"notes":"Требует объединения правил лицензии и области применения приказа № 102."}
{"case_id":"CV1-014","question":"Продлевается ли лицензия Альфа автоматически после первого года и на какой срок?","category":"insufficient_data","expected_sources":["example:product_alpha"],"required_facts":[],"forbidden_claims":[{"claim_id":"invented_renewal","description":"Утверждать автоматическое продление","pattern":"(?:лицензия|она) +автоматическ[^.]{0,40}продлев"}],"should_abstain":true,"manual_review_required":true,"notes":"Документ задаёт исходный срок, но ничего не говорит о продлении."}
{"case_id":"CV1-015","question":"Какой срок проверки агентского договора юридическим отделом в рабочих днях?","category":"insufficient_data","expected_sources":["example:agency_contract"],"required_facts":[],"forbidden_claims":[{"claim_id":"invented_days","description":"Назвать число рабочих дней","pattern":"(?:в течение|срок)[^.]{0,40}[0-9]+[^.]{0,20}(?:рабоч|дн)"}],"should_abstain":true,"manual_review_required":true,"notes":"Регламент описывает порядок, но не содержит сроков."}
{"case_id":"CV1-016","question":"Какой приказ действовал 1 февраля 2026 года и какая ставка тогда применялась ко всем сделкам?","category":"dates_and_changes","expected_sources":["example:order_101","example:order_102"],"required_facts":[],"forbidden_claims":[{"claim_id":"universal_scope","description":"Распространить приказ № 101 на все сделки","pattern":"№? *101[^.]{0,100}(?:все|любые) +сделк"},{"claim_id":"proven_effective","description":"Утверждать доказанный период действия","pattern":"1 +февраля[^.]{0,100}(?:точно|однозначно|действовал)"}],"should_abstain":true,"manual_review_required":true,"notes":"Есть даты документов, но нет effective_from/effective_to и универсальной области применения."}
{"case_id":"CV1-017","question":"Что изменилось в правилах пени между 10 января и 15 февраля 2026 года?","category":"dates_and_changes","expected_sources":["example:order_101","example:order_102"],"required_facts":[{"fact_id":"rate_101","description":"В приказе № 101 указано 0,10","patterns":["0[,.]10? *(?:%|процент)"],"source_id":"example:order_101","citation_required":true},{"fact_id":"rate_102","description":"В приказе № 102 указано 0,05","patterns":["0[,.]05 *(?:%|процент)"],"source_id":"example:order_102","citation_required":true}],"forbidden_claims":[{"claim_id":"replacement","description":"Считать второй приказ доказанным изменением или заменой первого","pattern":"№? *102[^.]{0,80}(?:изменил|заменил|отменил)"}],"should_abstain":false,"manual_review_required":true,"notes":"Можно сопоставить датированные ставки, но нельзя доказать изменение одной нормы: области применения различаются."}
{"case_id":"CV1-018","question":"Сколько дней ежегодного оплачиваемого отпуска положено сотрудникам компании?","category":"justified_abstention","expected_sources":[],"required_facts":[],"forbidden_claims":[{"claim_id":"invented_vacation","description":"Назвать число дней отпуска","pattern":"[0-9]+[^.]{0,20}(?:календарн|рабоч)[^.]{0,20}дн"}],"should_abstain":true,"manual_review_required":true,"notes":"В синтетическом корпусе нет кадровой политики; корректен обоснованный отказ."}
