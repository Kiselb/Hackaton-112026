{"case_id":"CV1-001","question":"Какой размер пени установлен приказом № 101 за каждый день просрочки предоплаты?","category":"single_document_fact","expected_sources":["example:order_101"],"required_facts":[{"fact_id":"rate_101","description":"Ставка 0,10 процента за календарный день","patterns":["0[,.]10? *(?:%|процент)","календарн"],"source_id":"example:order_101","citation_required":true}],"forbidden_claims":[{"claim_id":"wrong_rate","description":"Приписать приказу № 101 ставку 0,05","pattern":"№? *101[^.]{0,100}0[,.]05"}],"should_abstain":false,"notes":"Факт вручную сверен с пунктом 3 приказа № 101."}
